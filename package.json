{
  "name": "tracer-agent-web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "check:coauthors": "node scripts/check-coauthors.mjs",
    "lint": "npm run lint:format && npm run lint:types && npm run lint:structure && npm run lint:deps",
    "lint:format": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:types": "tsc --noEmit",
    "lint:structure": "node scripts/check-structure.mjs",
    "lint:deps": "depcruise --config .dependency-cruiser.mjs --ts-config tsconfig.json src",
    "test": "npm run test:scripts && vitest run",
    "test:scripts": "node --test \"scripts/**/*.test.mjs\"",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview"
  },
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "clsx": "^2.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^9.1.0",
    "react-router-dom": "^7.18.2",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.5.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@module-federation/vite": "^1.10.4",
    "@tailwindcss/vite": "^4.2.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.13.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "dependency-cruiser": "^16.10.4",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "js-yaml": "^4.3.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.63.0",
    "vite": "^7.0.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.0.0"
  }
}
